---
// Dinheiro de economia flutuando no topo do /grupo: cédulas voando, moedas
// que giram e um cofrinho, no traço dos desenhos do site (contorno preto,
// cor chapada, sombra dura; scripts/desenhos/desenhos.mjs, servidos por
// src/pages/brand/dinheiro-[peca].svg.ts). Decoração pura: sem clique e fora
// da árvore de acessibilidade. No celular ficam só uma cédula e duas moedas,
// nos cantos, para não brigar com o título.
const pecas = [
  { classe: 'c1', arq: 'cedula', l: 250, a: 150, celular: true },
  { classe: 'c2', arq: 'cedula', l: 250, a: 150, celular: false },
  { classe: 'm1', arq: 'moeda', l: 124, a: 124, celular: true },
  { classe: 'm2', arq: 'moeda', l: 124, a: 124, celular: true },
  { classe: 'm3', arq: 'moeda', l: 124, a: 124, celular: false },
  { classe: 'porco', arq: 'cofrinho', l: 266, a: 232, celular: false },
];
---

<div class="din" aria-hidden="true" data-anima>
  {
    pecas.map((p) => (
      <img
        class:list={['din__p', `din__${p.classe}`, { 'din__p--moeda': p.arq === 'moeda', 'din__p--pc': !p.celular }]}
        src={`/brand/dinheiro-${p.arq}.svg`}
        alt=""
        width={p.l}
        height={p.a}
        loading={p.celular ? undefined : 'lazy'}
        decoding="async"
      />
    ))
  }
</div>

<style>
  .din {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .din__p {
    position: absolute;
    height: auto;
    animation: din-flutua 4.6s ease-in-out infinite;
  }
  /* a moeda flutua e, de vez em quando, dá duas voltas no próprio eixo */
  .din__p--moeda {
    animation:
      din-flutua 4.2s ease-in-out infinite,
      din-gira 5s ease-in-out infinite;
  }

  .din__porco {
    animation: din-boia 3.8s ease-in-out -1s infinite;
  }

  /* celular: cédula saindo de trás da foto, moedas nos cantos de cima */
  @media (max-width: 899px) {
    .din__c1 {
      right: -16px;
      top: 190px;
      width: 88px;
      transform: rotate(14deg);
    }
    .din__m1 {
      left: 12px;
      top: 12px;
      width: 44px;
      animation-delay: -1.3s, -2s;
    }
    .din__m2 {
      right: 28px;
      top: 10px;
      width: 36px;
      animation-delay: -2.8s, -0.6s;
    }
  }
  @media (max-width: 599px) {
    .din__p--pc {
      display: none;
    }
  }
  /* tablet: sobra lugar dos lados do título e do botão */
  @media (min-width: 600px) and (max-width: 899px) {
    .din__c2 {
      left: 16px;
      top: 430px;
      width: 124px;
      transform: rotate(-10deg);
      animation-delay: -2.1s;
    }
    .din__m3 {
      left: 40px;
      top: 620px;
      width: 50px;
      animation-delay: -0.7s, -3.4s;
    }
    .din__porco {
      right: 14px;
      top: 590px;
      width: 150px;
    }
  }

  /* computador: em volta das pilhas de encomenda, fora da coluna do texto,
     sem passar da borda da tela quando ela é estreita */
  @media (min-width: 900px) {
    .din__c1 {
      left: max(10px, calc(50% - 590px));
      top: 452px;
      width: 170px;
      transform: rotate(-14deg);
      animation-duration: 5.2s;
    }
    .din__c2 {
      left: min(calc(50% + 395px), calc(100% - 176px));
      top: 56px;
      width: 156px;
      transform: rotate(12deg);
      animation-delay: -2.1s;
    }
    .din__m1 {
      left: max(24px, calc(50% - 470px));
      top: 58px;
      width: 74px;
      animation-delay: -1.3s, -2s;
    }
    .din__m2 {
      left: calc(50% - 304px);
      top: 590px;
      width: 60px;
      animation-delay: -2.8s, -0.6s;
    }
    .din__m3 {
      left: calc(50% + 196px);
      top: 180px;
      width: 52px;
      animation-delay: -0.7s, -3.4s;
    }
    .din__porco {
      left: min(calc(50% + 318px), calc(100% - 210px));
      top: 520px;
      width: 196px;
    }
  }

  /* translate, rotate e scale separados: somam com o rotate() fixo de cada peça */
  @keyframes din-flutua {
    0%,
    100% {
      translate: 0 0;
      rotate: -5deg;
    }
    50% {
      translate: 0 -14px;
      rotate: 5deg;
    }
  }
  @keyframes din-gira {
    0%,
    55%,
    100% {
      scale: 1 1;
    }
    64% {
      scale: 0.08 1;
    }
    72% {
      scale: 1 1;
    }
    80% {
      scale: 0.08 1;
    }
    88% {
      scale: 1 1;
    }
  }
  @keyframes din-boia {
    0%,
    100% {
      translate: 0 0;
      rotate: -2deg;
    }
    50% {
      translate: 0 -8px;
      rotate: 2deg;
    }
  }
</style>
