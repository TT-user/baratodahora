---
// Bloco "entrar no grupo". Só aparece se site.grupoWhatsApp tiver link.
// `forcar` existe só para o /styleguide mostrar o bloco sem link.
import Icone from './Icone.astro';
import { site } from '../site.config';

interface Props {
  forcar?: boolean;
}
const { forcar = false } = Astro.props;
const link = site.grupoWhatsApp || (forcar ? '#' : '');
---

{
  link && (
    <section class="grupo dark" aria-labelledby="grupo-titulo">
      <div class="wrap grupo__in">
        <svg class="grupo__deco" viewBox="0 0 100 100" width="120" height="120" aria-hidden="true">
          <rect x="8" y="8" width="84" height="84" rx="20" fill="none" stroke="#D62828" stroke-width="6" />
        </svg>
        <p class="eyebrow">Grupo de ofertas</p>
        <h2 id="grupo-titulo">
          Quer receber <em>antes de todo mundo?</em>
        </h2>
        <p class="muted">As ofertas chegam no seu WhatsApp assim que eu acho. Só eu posto, sem conversa paralela.</p>
        <a
          class="btn btn--whats btn--nudge"
          href={link}
          target="_blank"
          rel="noopener"
          data-loja="grupo"
          data-oferta="0"
          data-local="grupo"
        >
          <Icone nome="whatsapp" />
          Entrar no grupo
        </a>
        <p class="grupo__selos">
          <span>✓ Gratuito</span>
          <span>✓ Sai quando quiser</span>
        </p>
      </div>
    </section>
  )
}

<style>
  .grupo {
    position: relative;
    overflow: hidden;
  }
  .grupo__in {
    display: grid;
    gap: 14px;
    padding-top: 48px;
    padding-bottom: 52px;
    text-align: center;
  }
  .grupo__deco {
    position: absolute;
    right: -46px;
    top: -26px;
    rotate: 14deg;
    opacity: 0.5;
  }
  .grupo .eyebrow {
    color: var(--gold);
  }
  .grupo .btn {
    margin-top: 8px;
    box-shadow: 0 8px 0 0 #000;
  }
  .grupo__selos {
    display: flex;
    justify-content: center;
    gap: 16px;
    color: #c9c2b6;
    font-size: 14px;
  }
</style>
