---
// Logomarcas das lojas, para os botões e para os selinhos da lista.
// Shopee: o ícone oficial do Simple Icons (CC0). Mercado Livre e Amazon não
// estão no Simple Icons: são desenhos simplificados das marcas (o aperto de
// mãos na oval; o "a" com o sorriso). As marcas pertencem às lojas.
import { caminho } from '../lib/marca.mjs';
import type { Loja } from '../lib/ofertas';

interface Props {
  loja: Loja;
  class?: string;
}
const { loja, class: classe = '' } = Astro.props;

const SHOPEE =
  'M15.9414 17.9633c.229-1.879-.981-3.077-4.1758-4.0969-1.548-.528-2.277-1.22-2.26-2.1719.065-1.056 1.048-1.825 2.352-1.85a5.2898 5.2898 0 0 1 2.8838.89c.116.072.197.06.263-.039.09-.145.315-.494.39-.62.051-.081.061-.187-.068-.281-.185-.1369-.704-.4149-.983-.5319a6.4697 6.4697 0 0 0-2.5118-.514c-1.909.008-3.4129 1.215-3.5389 2.826-.082 1.1629.494 2.1078 1.73 2.8278.262.152 1.6799.716 2.2438.892 1.774.552 2.695 1.5419 2.478 2.6969-.197 1.047-1.299 1.7239-2.818 1.7439-1.2039-.046-2.2878-.537-3.1278-1.19l-.141-.11c-.104-.08-.218-.075-.287.03-.05.077-.376.547-.458.67-.077.108-.035.168.045.234.35.293.817.613 1.134.775a6.7097 6.7097 0 0 0 2.8289.727 4.9048 4.9048 0 0 0 2.0759-.354c1.095-.465 1.8029-1.394 1.9449-2.554zM11.9986 1.4009c-2.068 0-3.7539 1.95-3.8329 4.3899h7.6657c-.08-2.44-1.765-4.3899-3.8328-4.3899zm7.8516 22.5981-.08.001-15.7843-.002c-1.074-.04-1.863-.91-1.971-1.991l-.01-.195L1.298 6.2858a.459.459 0 0 1 .45-.494h4.9748C6.8448 2.568 9.1607 0 11.9996 0c2.8388 0 5.1537 2.5689 5.2757 5.7898h4.9678a.459.459 0 0 1 .458.483l-.773 15.5883-.007.131c-.094 1.094-.979 1.9769-2.0709 2.0059z';

// Mercado Livre: oval branca de contorno azul com o aperto de mãos
const AZUL_ML = '#2D3277';
const ML = `
  <ellipse cx="24" cy="16" rx="21.6" ry="14.2" fill="#fff" stroke="${AZUL_ML}" stroke-width="2.8"/>
  <g fill="none" stroke="${AZUL_ML}" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5.4 16.6c3-1.1 5.6-3.4 8.6-4.3 2.3-.7 4.4.1 6.5 1.5"/>
    <path d="M42.6 16.6c-3-1.1-5.4-3.2-8.2-4.1-2.6-.8-4.9.1-7.3 1.4l-5.6 3.1c-1 .6-.8 2 .4 2.2 1.6.3 3.3-.6 4.6-1.6"/>
    <path d="M21.6 21.5l1.9 1.7c.7.6 1.8.2 1.9-.7"/>
    <path d="M18.6 20.5l2.6 2.4c.7.6 1.8.3 1.9-.7"/>
    <path d="M15.8 19.1l3.1 2.7c.7.6 1.8.2 1.9-.7"/>
    <path d="M14 16.5l2.8 2.3c.7.6 1.7.3 1.9-.6"/>
    <path d="M25.6 18.6l1.6 1.4c.7.6 1.8.2 1.8-.7l-.2-.4"/>
    <path d="M29.6 16.8l1.6 1.6c.6.6 1.6.3 1.8-.5"/>
  </g>`;

// Amazon: "a" minúsculo com o sorriso-seta embaixo
const a = caminho('a', 22, 0, 0);
const AMAZON = `
  <path d="${a.d}" fill="currentColor" transform="translate(${16 - (a.x + a.largura / 2)} ${11 - (a.y + a.altura / 2)})"/>
  <path d="M4.6 18.4c6.8 4 15.4 4.2 22.4-.2" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
  <path d="M23.4 16.4l3.9 1.6-1.2 4" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>`;

const LOGOS: Partial<Record<Loja, { caixa: string; svg: string }>> = {
  shopee: { caixa: '0 0 24 24', svg: `<path fill="currentColor" d="${SHOPEE}"/>` },
  mercadolivre: { caixa: '0 0 48 32', svg: ML },
  amazon: { caixa: '0 0 32 24', svg: AMAZON },
};
const logo = LOGOS[loja];
---

{logo && <svg class={`logo-loja logo-loja--${loja} ${classe}`} viewBox={logo.caixa} aria-hidden="true" focusable="false" set:html={logo.svg} />}
