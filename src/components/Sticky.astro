---
// CTA fixo no rodapé. Aparece depois que a pessoa rola a página e some
// enquanto o elemento `alvo` (o botão principal, a busca) está à vista,
// para não ter dois botões iguais na tela. Escondido, fica `inert`.
interface Props {
  alvo: string;
}
const { alvo } = Astro.props;
---

<div class="sticky" data-sticky={alvo} inert>
  <slot />
</div>
