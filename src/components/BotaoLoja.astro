---
// Botão de loja: logomarca + nome da loja (laranja SHOPEE, amarelo MERCADO
// LIVRE...). O nome cresce e encolhe com a largura do botão; se não couber,
// fica só a logomarca (o leitor de tela continua lendo "Ver na Shopee").
// Link de afiliado sempre em aba nova, com rel="nofollow sponsored noopener".
// data-loja e data-oferta servem ao rastreio de cliques (desligado por padrão)
// e à cópia automática do cupom.
// Oferta encerrada: vira um bloco cinza sem link (nunca leva a link morto).
import Icone from './Icone.astro';
import LogoLoja from './LogoLoja.astro';
import { LOJA } from '../lib/catalogo.mjs';
import { naLoja, type LinkLoja } from '../lib/ofertas';

interface Props {
  link: LinkLoja;
  numero: number;
  local: string;
  pequeno?: boolean;
  nudge?: boolean;
  encerrada?: boolean;
  id?: string;
}
const { link, numero, local, pequeno = false, nudge = false, encerrada = false, id } = Astro.props;
const outra = link.loja === 'outra';
const { nome, prep } = LOJA[link.loja];
---

{
  encerrada ? (
    <span class:list={['btn', 'btn--off', { 'btn--sm': pequeno }]} id={id}>
      Encerrada {naLoja(link.loja)}
    </span>
  ) : (
    <a
      class:list={['btn', 'btn--loja', `btn--${link.loja}`, { 'btn--sm': pequeno, 'btn--nudge': nudge }]}
      href={link.url}
      target="_blank"
      rel="nofollow sponsored noopener"
      data-loja={link.loja}
      data-oferta={numero}
      data-local={local}
      id={id}
    >
      <LogoLoja loja={link.loja} class="btn__logo" />
      <span class="btn__nome">
        {outra ? (
          'Ver na loja'
        ) : (
          <>
            <span class="sr">Ver {prep} </span>
            {nome}
          </>
        )}
      </span>
      <Icone nome="seta" class="btn__seta" />
      <span class="sr"> (abre em outra aba)</span>
    </a>
  )
}
